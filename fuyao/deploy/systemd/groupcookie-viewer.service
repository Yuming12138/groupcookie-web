[Unit]
Description=GroupCookie Crystal Toolkit structure viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=groupcookie
Group=groupcookie
WorkingDirectory=/opt/groupcookie-fuyao/current
Environment=PYTHONUNBUFFERED=1
Environment=MPLCONFIGDIR=/opt/groupcookie-fuyao/cache/matplotlib
ExecStart=/opt/groupcookie-fuyao/venv/bin/python /opt/groupcookie-fuyao/current/structure_viewer.py --host 127.0.0.1 --port 8767
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
